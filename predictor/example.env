# Generated from the typed ESB configuration catalog. Run `make docs` after changing it.
# Copy this file to predictor/.env. Replace every sample credential before a private deployment.
# Duration units: ns, us/µs, ms, s, m, h. One day is 24h; one week is 168h.
# Byte limits use bytes (1 MiB = 1048576); *_DAYS settings use days; count limits use their named rows/items.
# Retention values: 0, 0s, or immediate = clean after processing and safety checks; a positive duration = retain that long; never = keep.
# CLEANUP_ENABLED=false disables scheduled retention and immediate cleanup notifications.
# Company metric units (for example ₽, %, тонн/месяц) are saved per company in PostgreSQL by Valera through ESB MCP.

# ESB runtime
# Directory containing agent.json, skills, and Hermes configuration. (type: string; default: ../agents; unit: —; range: not validated)
AGENTS_DIR=
# Absolute maximum execution time per call; polling and status updates do not extend it. (type: duration; default: 10m0s; unit: duration; range: 1s…24h0m0s)
CALL_EXECUTION_TIMEOUT=10m0s
# Maximum ClickHouse response body size accepted by ESB. (type: integer (int64); default: 4194304; unit: bytes; range: 1024…67108864)
CLICKHOUSE_MAX_RESPONSE_BYTES=4194304
# HTTP client timeout for ClickHouse requests. (type: duration; default: 45s; unit: duration; range: 1ms…1h0m0s)
CLICKHOUSE_REQUEST_TIMEOUT=45s
# Default page size for company fact and metric lists. (type: integer; default: 100; unit: items; range: 1…100000)
COMPANY_ITEMS_DEFAULT_PAGE_SIZE=100
# Maximum page size for company fact and metric lists. (type: integer; default: 500; unit: items; range: 1…100000)
COMPANY_ITEMS_MAX_PAGE_SIZE=500
# Maximum stored company analyses included in one report. (type: integer; default: 100; unit: analyses; range: 1…100000)
COMPANY_REPORT_ANALYSIS_LIMIT=100
# Default lookback period for company reports when dates are omitted. (type: integer; default: 30; unit: days; range: 1…3650)
COMPANY_REPORT_DEFAULT_WINDOW_DAYS=30
# Maximum company-linked facts included in one report. (type: integer; default: 200; unit: facts; range: 1…100000)
COMPANY_REPORT_FACTS_LIMIT=200
# Default fact/observation page size in real-time consultant context. (type: integer; default: 100; unit: items; range: 1…100000)
CONSULTANT_CONTEXT_DEFAULT_PAGE_SIZE=100
# Maximum fact/observation page size in real-time consultant context. (type: integer; default: 500; unit: items; range: 1…100000)
CONSULTANT_CONTEXT_MAX_PAGE_SIZE=500
# Maximum time spent requesting a compressed agent-context summary from Hermes. (type: duration; default: 30s; unit: duration; range: 1ms…1h0m0s)
CONTEXT_COMPACTION_TIMEOUT=30s
# Number of facts returned when a facts query omits limit. (type: integer; default: 100; unit: facts; range: 1…100000)
FACTS_DEFAULT_PAGE_SIZE=100
# Maximum facts returned by one paged facts query. (type: integer; default: 100; unit: facts; range: 1…100000)
FACTS_MAX_PAGE_SIZE=100
# Maximum allowed time span for a filtered facts query. (type: integer; default: 90; unit: days; range: 1…3650)
FACTS_MAX_PERIOD_DAYS=90
# Per-agent readiness probe timeout. (type: duration; default: 2s; unit: duration; range: 1ms…1m0s)
HERMES_HEALTH_TIMEOUT=2s
# Named Kesha runtime pool as id=state@url entries separated by semicolons. (type: string; default: empty / unset; unit: —; range: not validated)
HERMES_KESHA_INSTANCES=kesha-1=available@http://hermes-kesha:8642;kesha-2=available@http://hermes-kesha-2:8642
# Legacy single Kesha Hermes URL; use HERMES_KESHA_INSTANCES for a pool. (type: string; default: empty / unset; unit: —; range: not validated)
HERMES_KESHA_URL=
# Named Konstantin runtime pool as id=state@url entries separated by semicolons. (type: string; default: empty / unset; unit: —; range: not validated)
HERMES_KONSTANTIN_INSTANCES=konstantin-1=available@http://hermes-konstantin:8642;konstantin-2=available@http://hermes-konstantin-2:8642
# Legacy single Konstantin Hermes URL; use HERMES_KONSTANTIN_INSTANCES for a pool. (type: string; default: empty / unset; unit: —; range: not validated)
HERMES_KONSTANTIN_URL=
# Maximum response body size accepted from Hermes. (type: integer (int64); default: 1048576; unit: bytes; range: 1024…16777216)
HERMES_MAX_RESPONSE_BYTES=1048576
# Queue dispatch and Hermes status polling interval. (type: duration; default: 2s; unit: interval; range: 1ms…10m0s)
HERMES_POLL_INTERVAL=2s
# HTTP client timeout for Hermes run, status, and health requests. (type: duration; default: 45s; unit: duration; range: 1ms…10m0s)
HERMES_REQUEST_TIMEOUT=45s
# Base delay between Hermes submission retries; retry delay grows linearly by attempt. (type: duration; default: 1s; unit: duration; range: 0s…5m0s)
HERMES_RETRY_BASE_DELAY=1s
# Total attempts to submit a run to Hermes, including the first attempt. (type: integer; default: 5; unit: attempts; range: 1…20)
HERMES_RETRY_MAX_ATTEMPTS=5
# Named Saveliy runtime pool as id=state@url entries separated by semicolons. (type: string; default: empty / unset; unit: —; range: not validated)
HERMES_SAVELIY_INSTANCES=saveliy-1=available@http://hermes-saveliy:8642;saveliy-2=available@http://hermes-saveliy-2:8642
# Legacy single Saveliy Hermes URL; use HERMES_SAVELIY_INSTANCES for a pool. (type: string; default: empty / unset; unit: —; range: not validated)
HERMES_SAVELIY_URL=
# Named Serezha runtime pool as id=state@url entries separated by semicolons. (type: string; default: empty / unset; unit: —; range: not validated)
HERMES_SEREZHA_INSTANCES=serezha-1=available@http://hermes-serezha:8642;serezha-2=available@http://hermes-serezha-2:8642
# Legacy single Serezha Hermes URL; use HERMES_SEREZHA_INSTANCES for a pool. (type: string; default: empty / unset; unit: —; range: not validated)
HERMES_SEREZHA_URL=
# HTTP timeout for one Hermes Run API stop request; acceptance is not terminal confirmation. (type: duration; default: 5s; unit: duration; range: 1ms…1m0s)
HERMES_STOP_REQUEST_TIMEOUT=5s
# Named Valera runtime pool as id=state@url entries separated by semicolons. (type: string; default: empty / unset; unit: —; range: not validated)
HERMES_VALERA_INSTANCES=valera-1=available@http://hermes-valera:8642;valera-2=available@http://hermes-valera-2:8642
# Legacy single Valera Hermes URL; use HERMES_VALERA_INSTANCES for a pool. (type: string; default: empty / unset; unit: —; range: not validated)
HERMES_VALERA_URL=
# ESB listen address inside its network namespace. (type: string; default: :8081; unit: —; range: not validated)
HTTP_ADDR=:8081
# HTTP server timeout for idle keep-alive connections. (type: duration; default: 1m0s; unit: duration; range: 1ms…24h0m0s)
HTTP_IDLE_TIMEOUT=1m0s
# Maximum JSON request body accepted by HTTP endpoints. (type: integer (int64); default: 2097152; unit: bytes; range: 1024…67108864)
HTTP_MAX_JSON_BODY_BYTES=2097152
# HTTP server timeout for receiving request headers. (type: duration; default: 5s; unit: duration; range: 1ms…10m0s)
HTTP_READ_HEADER_TIMEOUT=5s
# Grace period for HTTP server shutdown after a termination signal. (type: duration; default: 10s; unit: duration; range: 1ms…10m0s)
HTTP_SHUTDOWN_TIMEOUT=10s
# Interval for checking PostgreSQL for a completed real-time consultant answer. (type: duration; default: 300ms; unit: interval; range: 1ms…1m0s)
KONSTANTIN_EVENT_POLL_INTERVAL=300ms
# Default number of chat-history messages returned by one request. (type: integer; default: 100; unit: messages; range: 1…100000)
KONSTANTIN_HISTORY_DEFAULT_PAGE_SIZE=100
# Default lookback period for Konstantin chat history. (type: integer; default: 30; unit: days; range: 1…3650)
KONSTANTIN_HISTORY_DEFAULT_WINDOW_DAYS=30
# Maximum number of chat-history messages returned by one request. (type: integer; default: 100; unit: messages; range: 1…100000)
KONSTANTIN_HISTORY_MAX_PAGE_SIZE=100
# Maximum time span for Konstantin chat-history requests. (type: integer; default: 90; unit: days; range: 1…3650)
KONSTANTIN_HISTORY_MAX_WINDOW_DAYS=90
# Maximum company metric settings accepted in one update. (type: integer; default: 500; unit: metrics; range: 1…100000)
MAX_COMPANY_METRICS_PER_REQUEST=500
# Maximum facts stored for a single news item in one MCP call. (type: integer; default: 500; unit: facts; range: 1…100000)
MAX_FACTS_PER_NEWS=500
# Maximum fact-to-company links stored in one MCP call. (type: integer; default: 1000; unit: links; range: 1…100000)
MAX_FACT_COMPANY_LINKS_PER_REQUEST=1000
# Maximum metric observations stored in one MCP call. (type: integer; default: 1000; unit: observations; range: 1…100000)
MAX_METRIC_OBSERVATIONS_PER_REQUEST=1000
# Maximum raw news text accepted before Hermes processing. (type: integer (int64); default: 1048576; unit: bytes; range: 1…67108864)
MAX_NEWS_TEXT_BYTES=1048576
# Maximum UTF-8 question text accepted over Konstantin WebSocket. (type: integer (int64); default: 1048576; unit: bytes; range: 1…16777216)
MAX_QUESTION_BYTES=1048576
# Maximum queued calls claimed in one dispatch cycle; each claim can start one worker. (type: integer; default: 100; unit: calls; range: 1…10000)
QUEUE_DISPATCH_BATCH_SIZE=100
# Maximum company Markdown profile read from or written to S3. (type: integer (int64); default: 2097152; unit: bytes; range: 1…67108864)
S3_PROFILE_MAX_BYTES=2097152
# Maximum prior Konstantin events replayed after WebSocket subscription. (type: integer; default: 500; unit: events; range: 1…10000)
STREAM_REPLAY_LIMIT=500
# Maximum automatic retries after Valera output is completed but its profile revision is not confirmed; PostgreSQL retry_count allows 0..1. (type: integer; default: 1; unit: retries; range: 0…1)
VALERA_PROFILE_SYNC_MAX_RETRIES=1
# Maximum inbound WebSocket frame size. (type: integer (int64); default: 1048576; unit: bytes; range: 1024…16777216)
WS_MAX_FRAME_BYTES=1048576
# Bounded queue of outbound WebSocket frames per connection. (type: integer; default: 64; unit: frames; range: 1…65536)
WS_OUTGOING_QUEUE_SIZE=64
# Maximum idle time waiting for one WebSocket frame; zero keeps subscriptions open indefinitely. (type: duration; default: 0s; unit: duration; range: 0s…1h0m0s)
WS_READ_TIMEOUT=0s
# Maximum time to write one WebSocket frame. (type: duration; default: 15s; unit: duration; range: 1ms…10m0s)
WS_WRITE_TIMEOUT=15s

# Hermes gateway and MCP
# Shared Hermes model-provider identifier for all agents. (type: string; default: custom; unit: —; range: not validated)
HERMES_MODEL_PROVIDER=custom

# Per-agent model and runtime
# KESHA maximum concurrent runs per Hermes instance; values below one are rejected. (type: integer; default: 1; unit: runs; range: 1…100000)
AGENT_KESHA_MAX_CONCURRENT_RUNS=1
# KESHA Hermes maximum turns per run. (type: integer; default: 12; unit: turns; range: 1…1000)
AGENT_KESHA_MAX_TURNS=12
# KESHA model identifier sent to the configured provider. (type: string; default: google/gemma-4-26b-a4b-it; unit: —; range: not validated)
AGENT_KESHA_MODEL_ID=google/gemma-4-26b-a4b-it
# KESHA Hermes reasoning-effort setting supported by its model/provider. (type: string; default: low; unit: —; range: not validated)
AGENT_KESHA_REASONING_EFFORT=low
# KONSTANTIN maximum concurrent runs per Hermes instance; values below one are rejected. (type: integer; default: 1; unit: runs; range: 1…100000)
AGENT_KONSTANTIN_MAX_CONCURRENT_RUNS=1
# KONSTANTIN Hermes maximum turns per run. (type: integer; default: 12; unit: turns; range: 1…1000)
AGENT_KONSTANTIN_MAX_TURNS=12
# KONSTANTIN model identifier sent to the configured provider. (type: string; default: google/gemma-4-26b-a4b-it; unit: —; range: not validated)
AGENT_KONSTANTIN_MODEL_ID=google/gemma-4-26b-a4b-it
# KONSTANTIN Hermes reasoning-effort setting supported by its model/provider. (type: string; default: low; unit: —; range: not validated)
AGENT_KONSTANTIN_REASONING_EFFORT=low
# SAVELIY maximum concurrent runs per Hermes instance; values below one are rejected. (type: integer; default: 1; unit: runs; range: 1…100000)
AGENT_SAVELIY_MAX_CONCURRENT_RUNS=1
# SAVELIY Hermes maximum turns per run. (type: integer; default: 8; unit: turns; range: 1…1000)
AGENT_SAVELIY_MAX_TURNS=8
# SAVELIY model identifier sent to the configured provider. (type: string; default: google/gemma-4-26b-a4b-it; unit: —; range: not validated)
AGENT_SAVELIY_MODEL_ID=google/gemma-4-26b-a4b-it
# SAVELIY Hermes reasoning-effort setting supported by its model/provider. (type: string; default: low; unit: —; range: not validated)
AGENT_SAVELIY_REASONING_EFFORT=low
# SEREZHA maximum concurrent runs per Hermes instance; values below one are rejected. (type: integer; default: 1; unit: runs; range: 1…100000)
AGENT_SEREZHA_MAX_CONCURRENT_RUNS=1
# SEREZHA Hermes maximum turns per run. (type: integer; default: 8; unit: turns; range: 1…1000)
AGENT_SEREZHA_MAX_TURNS=8
# SEREZHA model identifier sent to the configured provider. (type: string; default: google/gemma-4-26b-a4b-it; unit: —; range: not validated)
AGENT_SEREZHA_MODEL_ID=google/gemma-4-26b-a4b-it
# SEREZHA Hermes reasoning-effort setting supported by its model/provider. (type: string; default: low; unit: —; range: not validated)
AGENT_SEREZHA_REASONING_EFFORT=low
# VALERA maximum concurrent runs per Hermes instance; values below one are rejected. (type: integer; default: 1; unit: runs; range: 1…100000)
AGENT_VALERA_MAX_CONCURRENT_RUNS=1
# VALERA Hermes maximum turns per run. (type: integer; default: 10; unit: turns; range: 1…1000)
AGENT_VALERA_MAX_TURNS=10
# VALERA model identifier sent to the configured provider. (type: string; default: google/gemma-4-26b-a4b-it; unit: —; range: not validated)
AGENT_VALERA_MODEL_ID=google/gemma-4-26b-a4b-it
# VALERA Hermes reasoning-effort setting supported by its model/provider. (type: string; default: low; unit: —; range: not validated)
AGENT_VALERA_REASONING_EFFORT=low

# Storage endpoints
# ClickHouse database name. (type: string; default: default; unit: —; range: not validated)
CLICKHOUSE_DATABASE=default
# ClickHouse HTTP interface URL. (type: string; default: http://localhost:8123; unit: —; range: not validated)
CLICKHOUSE_URL=
# ClickHouse account used by ESB. (type: string; default: predictor; unit: —; range: not validated)
CLICKHOUSE_USER=predictor
# S3 bucket for company Markdown profiles. (type: string; default: required; unit: —; range: not validated)
S3_BUCKET=company-profiles
# Create the configured S3 bucket during ESB startup when missing. (type: bool; default: false; unit: —; range: true | false)
S3_CREATE_BUCKET=true
# Optional S3-compatible endpoint; empty selects AWS endpoint discovery. (type: string; default: empty / unset; unit: —; range: not validated)
S3_ENDPOINT=http://minio:9000
# Use path-style S3 URLs; typically enabled for MinIO. (type: bool; default: false; unit: —; range: true | false)
S3_FORCE_PATH_STYLE=true
# S3 signing region. (type: string; default: us-east-1; unit: —; range: not validated)
S3_REGION=us-east-1

# Retention and cleanup
# Maximum cleanup retries for calls Hermes confirms failed or interrupted; active or uncertain runs are never retried. (type: integer; default: 1; unit: retries; range: 0…32767)
CLEANUP_ACTIVE_MAX_RETRIES=1
# Maximum candidate rows handled per cleanup category in one pass. (type: integer; default: 500; unit: rows; range: 1…10000)
CLEANUP_BATCH_SIZE=500
# Age before large request and output fields of terminal calls are cleared; Serezha retry payloads stay available until processing succeeds. (type: duration | immediate | never; default: 2160h; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_CALL_PAYLOAD_RETENTION=2160h
# Age before terminal call rows are deleted when safe or reduced to idempotency and history tombstones. (type: duration | immediate | never; default: 2160h; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_CALL_RECORD_RETENTION=2160h
# Retention for generated company analysis text. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_COMPANY_ANALYSES_RETENTION=never
# Independent retention for compacted agent context summaries. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_CONTEXT_SUMMARY_RETENTION=never
# Enable ESB stale-call recovery and retention cleanup loops, including immediate cleanup after terminal calls. (type: bool; default: true; unit: —; range: true | false)
CLEANUP_ENABLED=true
# Retention for ClickHouse universal facts. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_FACTS_RETENTION=never
# Retention for ClickHouse fact-to-company links. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_FACT_COMPANY_RETENTION=never
# Retention for Kesha conversation messages. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_MESSAGES_RETENTION_KESHA=never
# Retention for Konstantin chat history exposed to Domain. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_MESSAGES_RETENTION_KONSTANTIN=never
# Retention for Saveliy conversation messages. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_MESSAGES_RETENTION_SAVELIY=never
# Retention for Serezha conversation messages. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_MESSAGES_RETENTION_SEREZHA=never
# Retention for Valera conversation messages. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_MESSAGES_RETENTION_VALERA=never
# Retention for metric observations. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_METRIC_OBSERVATIONS_RETENTION=never
# Retention for calculated metric totals. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_METRIC_TOTALS_RETENTION=never
# Retention for processing markers only when no raw text or analytic rows depend on them. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_NEWS_MARKER_RETENTION=never
# Retention for unreferenced ClickHouse news metadata; metadata required by retained facts or observations is preserved. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_NEWS_METADATA_RETENTION=never
# Retention after ClickHouse confirms news processing and persisted facts; this age starts at the processing marker. (type: duration | immediate | never; default: 168h; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_PROCESSED_NEWS_TEXT_RETENTION=168h
# Age after which a submitting call without a saved Hermes run ID can be safely returned to the queue. (type: duration; default: 10m0s; unit: duration; range: 1ms…8760h0m0s)
CLEANUP_QUEUED_STALE_AFTER=10m0s
# Interval between bounded PostgreSQL and ClickHouse retention passes. (type: duration; default: 24h0m0s; unit: interval; range: 1ms…8760h0m0s)
CLEANUP_RETENTION_CHECK_INTERVAL=24h0m0s
# Minimum age before cleanup independently checks the Hermes status of an active call. (type: duration; default: 30m0s; unit: duration; range: 1ms…8760h0m0s)
CLEANUP_RUNNING_STALE_AFTER=30m0s
# Interval between stale-call reconciliation passes; kept separate from data-retention cleanup. (type: duration; default: 1h0m0s; unit: interval; range: 1ms…8760h0m0s)
CLEANUP_STATUS_CHECK_INTERVAL=1h0m0s
# Retention for raw text only when its news call is terminal and the text is not marked processed. (type: duration | immediate | never; default: never; unit: duration; range: 0 | immediate | positive Go duration | never)
CLEANUP_UNPROCESSED_NEWS_TEXT_RETENTION=never

# Credentials and secrets: placeholders only
# Optional Atlas token used by the ClickHouse Atlas driver. (type: string; default: sample/required; unit: —; range: not validated)
ATLAS_TOKEN=
# ClickHouse account password. (type: string; default: sample/required; unit: —; range: not validated)
CLICKHOUSE_PASSWORD=local-clickhouse-password
# PostgreSQL connection URL used only by ESB. (type: string; default: sample/required; unit: —; range: not validated)
DATABASE_URL=
# Bearer key for Domain HTTP and WebSocket integration; it does not authorize MCP tools. (type: string; default: sample/required; unit: —; range: not validated)
ESB_API_KEY=replace-with-a-random-esb-bearer-key
# Bearer key ESB uses for Hermes runtime calls. (type: string; default: sample/required; unit: —; range: not validated)
HERMES_API_KEY=replace-with-a-random-hermes-bearer-key
# LLM provider key consumed by Hermes, never by ESB. (type: string; default: sample/required; unit: —; range: not validated)
LLM_API_KEY=replace-with-your-LLM-provider-key
# Agent-only Bearer token for the ESB MCP endpoint; unique and separate from integration keys. (type: string; default: sample/required; unit: bytes; range: 32…256)
MCP_TOKEN_KESHA=replace-with-random-kesha-mcp-token-00000004
# Agent-only Bearer token for the ESB MCP endpoint; unique and separate from integration keys. (type: string; default: sample/required; unit: bytes; range: 32…256)
MCP_TOKEN_KONSTANTIN=replace-with-random-konstantin-mcp-token-00000005
# Agent-only Bearer token for the ESB MCP endpoint; unique and separate from integration keys. (type: string; default: sample/required; unit: bytes; range: 32…256)
MCP_TOKEN_SAVELIY=replace-with-random-saveliy-mcp-token-00000002
# Agent-only Bearer token for the ESB MCP endpoint; unique and separate from integration keys. (type: string; default: sample/required; unit: bytes; range: 32…256)
MCP_TOKEN_SEREZHA=replace-with-random-serezha-mcp-token-00000001
# Agent-only Bearer token for the ESB MCP endpoint; unique and separate from integration keys. (type: string; default: sample/required; unit: bytes; range: 32…256)
MCP_TOKEN_VALERA=replace-with-random-valera-mcp-token-00000003
# Local MinIO root password; replace for private deployments. (type: string; default: sample/required; unit: —; range: not validated)
MINIO_ROOT_PASSWORD=local-minio-password-change-me
# Local MinIO root account. (type: string; default: sample/required; unit: —; range: not validated)
MINIO_ROOT_USER=predictor-local
# Local Compose PostgreSQL password; replace for private deployments. (type: string; default: sample/required; unit: —; range: not validated)
POSTGRES_PASSWORD=local-predictor-password
# Optional static S3 access key; pair with S3_SECRET_ACCESS_KEY. (type: string; default: sample/required; unit: —; range: not validated)
S3_ACCESS_KEY_ID=predictor-local
# Optional static S3 secret key; pair with S3_ACCESS_KEY_ID. (type: string; default: sample/required; unit: —; range: not validated)
S3_SECRET_ACCESS_KEY=local-minio-password-change-me

# Docker Compose runtime
# ClickHouse container healthcheck interval in Compose. (type: duration; default: 5s; unit: duration; range: 1ms…1h0m0s)
CLICKHOUSE_HEALTHCHECK_INTERVAL=5s
# Consecutive ClickHouse healthcheck failures before the container is unhealthy. (type: integer; default: 20; unit: retries; range: 1…100)
CLICKHOUSE_HEALTHCHECK_RETRIES=20
# ClickHouse container healthcheck command timeout in Compose. (type: duration; default: 3s; unit: duration; range: 1ms…1h0m0s)
CLICKHOUSE_HEALTHCHECK_TIMEOUT=3s
# ESB container healthcheck interval in Compose. (type: duration; default: 10s; unit: duration; range: 1ms…1h0m0s)
ESB_HEALTHCHECK_INTERVAL=10s
# Consecutive ESB healthcheck failures before the container is unhealthy. (type: integer; default: 20; unit: retries; range: 1…100)
ESB_HEALTHCHECK_RETRIES=20
# ESB container healthcheck command timeout in Compose. (type: duration; default: 3s; unit: duration; range: 1ms…1h0m0s)
ESB_HEALTHCHECK_TIMEOUT=3s
# Host port published for the ESB HTTP service. (type: integer; default: 8081; unit: port; range: 1…65535)
ESB_HOST_PORT=8081
# Host port published for the MinIO S3 API. (type: integer; default: 9000; unit: port; range: 1…65535)
MINIO_API_HOST_PORT=9000
# Host port published for the MinIO console. (type: integer; default: 9001; unit: port; range: 1…65535)
MINIO_CONSOLE_HOST_PORT=9001
# MinIO container healthcheck interval in Compose. (type: duration; default: 3s; unit: duration; range: 1ms…1h0m0s)
MINIO_HEALTHCHECK_INTERVAL=3s
# Consecutive MinIO healthcheck failures before the container is unhealthy. (type: integer; default: 30; unit: retries; range: 1…100)
MINIO_HEALTHCHECK_RETRIES=30
# MinIO container healthcheck command timeout in Compose. (type: duration; default: 2s; unit: duration; range: 1ms…1h0m0s)
MINIO_HEALTHCHECK_TIMEOUT=2s
# Database name for the PostgreSQL Compose service. (type: string; default: predictor; unit: —; range: not validated)
POSTGRES_DB=predictor
# PostgreSQL container healthcheck interval in Compose. (type: duration; default: 5s; unit: duration; range: 1ms…1h0m0s)
POSTGRES_HEALTHCHECK_INTERVAL=5s
# Consecutive PostgreSQL healthcheck failures before the container is unhealthy. (type: integer; default: 20; unit: retries; range: 1…100)
POSTGRES_HEALTHCHECK_RETRIES=20
# PostgreSQL container healthcheck command timeout in Compose. (type: duration; default: 3s; unit: duration; range: 1ms…1h0m0s)
POSTGRES_HEALTHCHECK_TIMEOUT=3s
# Account name for the PostgreSQL Compose service. (type: string; default: predictor; unit: —; range: not validated)
POSTGRES_USER=predictor

# Test-only settings
# Test-only base URL for the ESB E2E suite. (type: string; default: http://127.0.0.1:18081; unit: —; range: not validated)
ESB_E2E_BASE_URL=http://127.0.0.1:18081
# Test-only listening port for the mock Hermes runtime. (type: string; default: 8090; unit: —; range: not validated)
MOCK_PORT=8090
