{
  "asyncapi": "2.6.0",
  "channels": {
    "/stream": {
      "description": "Konstantin's company-scoped conversation. Connect using the streamUrl returned by GET /call?agent=konstantin.",
      "parameters": {
        "afterMessageId": {
          "description": "Optional replay cursor; only later persisted messages are sent.",
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        },
        "companyId": {
          "description": "Company UUID.",
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        },
        "conversationId": {
          "description": "Company-scoped conversation ID.",
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        },
        "requestId": {
          "description": "Optional request to observe until its one-shot answer or terminal state.",
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        }
      },
      "publish": {
        "message": {
          "oneOf": [
            {
              "$ref": "#/components/messages/Question"
            },
            {
              "$ref": "#/components/messages/Cancel"
            }
          ]
        },
        "operationId": "askKonstantin",
        "summary": "Send a question to Konstantin."
      },
      "subscribe": {
        "message": {
          "oneOf": [
            {
              "$ref": "#/components/messages/ConsultantEvent"
            },
            {
              "$ref": "#/components/messages/Accepted"
            },
            {
              "$ref": "#/components/messages/CancelRequested"
            },
            {
              "$ref": "#/components/messages/CancelFailed"
            },
            {
              "$ref": "#/components/messages/AssistantCancelled"
            },
            {
              "$ref": "#/components/messages/StreamError"
            }
          ]
        },
        "operationId": "receiveKonstantinEvents",
        "summary": "Receive one complete final answer in text, or cancellation lifecycle events. Internal reasoning and token deltas are not emitted."
      }
    }
  },
  "components": {
    "messages": {
      "Accepted": {
        "contentType": "application/json",
        "name": "Accepted",
        "payload": {
          "$ref": "#/components/schemas/Accepted"
        }
      },
      "AssistantCancelled": {
        "contentType": "application/json",
        "name": "AssistantCancelled",
        "payload": {
          "$ref": "#/components/schemas/AssistantCancelled"
        }
      },
      "Cancel": {
        "contentType": "application/json",
        "name": "Cancel",
        "payload": {
          "$ref": "#/components/schemas/Cancel"
        }
      },
      "CancelFailed": {
        "contentType": "application/json",
        "name": "CancelFailed",
        "payload": {
          "$ref": "#/components/schemas/CancelFailed"
        }
      },
      "CancelRequested": {
        "contentType": "application/json",
        "name": "CancelRequested",
        "payload": {
          "$ref": "#/components/schemas/CancelRequested"
        }
      },
      "ConsultantEvent": {
        "contentType": "application/json",
        "name": "ConsultantEvent",
        "payload": {
          "$ref": "#/components/schemas/ConsultantEvent"
        }
      },
      "Question": {
        "contentType": "application/json",
        "name": "Question",
        "payload": {
          "$ref": "#/components/schemas/Question"
        }
      },
      "StreamError": {
        "contentType": "application/json",
        "name": "StreamError",
        "payload": {
          "$ref": "#/components/schemas/StreamError"
        }
      }
    },
    "schemas": {
      "Accepted": {
        "additionalProperties": false,
        "properties": {
          "callId": {
            "description": "Queued Hermes call ID.",
            "type": "string"
          },
          "kind": {
            "description": "Message kind; always accepted.",
            "enum": [
              "accepted"
            ],
            "type": "string"
          },
          "requestId": {
            "description": "Question request ID.",
            "type": "string"
          },
          "responseId": {
            "description": "Stable identifier for this one-shot answer; equal to callId.",
            "type": "string"
          },
          "reused": {
            "description": "True when an idempotent earlier call was reused.",
            "type": "boolean"
          },
          "sequence": {
            "description": "First lifecycle sequence number; always zero.",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "requestId",
          "callId",
          "responseId",
          "sequence",
          "reused"
        ],
        "title": "Accepted",
        "type": "object"
      },
      "AssistantCancelled": {
        "additionalProperties": false,
        "properties": {
          "callId": {
            "description": "ESB call ID.",
            "type": "string"
          },
          "incomplete": {
            "description": "True because no final assistant answer was saved.",
            "type": "boolean"
          },
          "kind": {
            "description": "Message kind; always assistant_cancelled.",
            "enum": [
              "assistant_cancelled"
            ],
            "type": "string"
          },
          "requestId": {
            "description": "Question request ID.",
            "type": "string"
          },
          "responseId": {
            "description": "Stable answer identifier; equal to callId.",
            "type": "string"
          },
          "sequence": {
            "description": "Terminal sequence number for this call.",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "requestId",
          "callId",
          "responseId",
          "sequence",
          "incomplete"
        ],
        "title": "AssistantCancelled",
        "type": "object"
      },
      "Cancel": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "description": "Message kind; must be cancel.",
            "enum": [
              "cancel"
            ],
            "type": "string"
          },
          "requestId": {
            "description": "Request ID of the Konstantin question to cancel.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "requestId"
        ],
        "title": "Cancel",
        "type": "object"
      },
      "CancelFailed": {
        "additionalProperties": false,
        "properties": {
          "callId": {
            "description": "ESB call ID.",
            "type": "string"
          },
          "error": {
            "description": "Stable error code; never includes Hermes details.",
            "type": "string"
          },
          "kind": {
            "description": "Message kind; always cancel_failed.",
            "enum": [
              "cancel_failed"
            ],
            "type": "string"
          },
          "requestId": {
            "description": "Question request ID.",
            "type": "string"
          },
          "responseId": {
            "description": "Stable answer identifier; equal to callId.",
            "type": "string"
          },
          "sequence": {
            "description": "Monotonic sequence number for this call.",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "requestId",
          "callId",
          "responseId",
          "sequence",
          "error"
        ],
        "title": "CancelFailed",
        "type": "object"
      },
      "CancelRequested": {
        "additionalProperties": false,
        "properties": {
          "callId": {
            "description": "ESB call ID.",
            "type": "string"
          },
          "kind": {
            "description": "Message kind; always cancel_requested.",
            "enum": [
              "cancel_requested"
            ],
            "type": "string"
          },
          "requestId": {
            "description": "Cancelled question request ID.",
            "type": "string"
          },
          "responseId": {
            "description": "Stable answer identifier; equal to callId.",
            "type": "string"
          },
          "sequence": {
            "description": "Monotonic sequence number for this call.",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "requestId",
          "callId",
          "responseId",
          "sequence"
        ],
        "title": "CancelRequested",
        "type": "object"
      },
      "ConsultantEvent": {
        "additionalProperties": false,
        "properties": {
          "analysisId": {
            "type": "string"
          },
          "callId": {
            "type": "string"
          },
          "companyId": {
            "type": "string"
          },
          "conversationId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "evidence": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "materialKind": {
                  "type": "string"
                },
                "newsId": {
                  "type": "string"
                },
                "originKind": {
                  "type": "string"
                },
                "publishedAt": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "sourceId": {
                  "type": "string"
                },
                "sourceUrl": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "sourceId",
                "newsId",
                "materialKind",
                "originKind"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "kind": {
            "enum": [
              "analysis_result",
              "assistant_answer"
            ],
            "type": "string"
          },
          "messageId": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "responseId": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "integer"
          },
          "sequence": {
            "type": "integer"
          },
          "text": {
            "description": "Final user-facing answer text only; never internal reasoning or model metadata.",
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "kind",
          "requestId",
          "companyId",
          "conversationId",
          "analysisId",
          "messageId",
          "text",
          "evidence",
          "createdAt"
        ],
        "title": "ConsultantEvent",
        "type": "object"
      },
      "Question": {
        "additionalProperties": false,
        "properties": {
          "analysisId": {
            "description": "Current ready analysis ID.",
            "type": "string"
          },
          "companyId": {
            "description": "Optional company UUID; if supplied it must match the subscription.",
            "type": "string"
          },
          "conversationId": {
            "description": "Optional chat ID; if supplied it must match the subscription.",
            "type": "string"
          },
          "kind": {
            "description": "Message kind; must be question.",
            "enum": [
              "question"
            ],
            "type": "string"
          },
          "requestId": {
            "description": "Idempotency ID for this user question.",
            "type": "string"
          },
          "text": {
            "description": "User question.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "requestId",
          "analysisId",
          "text"
        ],
        "title": "Question",
        "type": "object"
      },
      "StreamError": {
        "additionalProperties": false,
        "properties": {
          "callId": {
            "description": "ESB call ID when a call exists.",
            "type": "string"
          },
          "error": {
            "description": "Stable machine-readable error code.",
            "type": "string"
          },
          "incomplete": {
            "description": "True when no complete answer was saved.",
            "type": "boolean"
          },
          "kind": {
            "description": "Message kind; always error.",
            "enum": [
              "error"
            ],
            "type": "string"
          },
          "requestId": {
            "description": "Related request ID when available.",
            "type": "string"
          },
          "responseId": {
            "description": "Stable answer identifier when a call exists.",
            "type": "string"
          },
          "sequence": {
            "description": "Monotonic sequence number when a call exists.",
            "type": "integer"
          },
          "terminal": {
            "description": "True when no later answer event will follow on this connection.",
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "error"
        ],
        "title": "StreamError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The only WebSocket API in ESB. Questions are answered with one saved assistant_answer message containing only final user-facing text and verified evidence; internal reasoning and token deltas are never emitted. The client may cancel one request by requestId.",
    "title": "Predictor ESB Konstantin WebSocket",
    "version": "0.3.0"
  },
  "servers": {
    "local": {
      "description": "Send Authorization: Bearer $ESB_API_KEY during the handshake.",
      "protocol": "ws",
      "url": "localhost:8081"
    }
  }
}
