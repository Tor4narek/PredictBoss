          "company_id",
          "news_id"
        ],
        "title": "SaveliyCallBody",
        "type": "object"
      },
      "SerezhaCallBody": {
        "additionalProperties": false,
        "properties": {
          "company_id": {
            "description": "Optional company UUID.",
            "type": "string"
          },
          "material_kind": {
            "description": "Material kind: external_news or alpha_analysis.",
            "type": "string"
          },
          "media_type": {
            "description": "Source media type: text/html or application/pdf.",
            "type": "string"
          },
          "news_id": {
            "description": "Stable news identifier.",
            "type": "string"
          },
          "news_text": {
            "description": "Cleaned text of the news article; maximum size is configured by MAX_NEWS_TEXT_BYTES.",
            "type": "string"
          },
          "published_at": {
            "description": "Publication timestamp in RFC 3339 format.",
            "type": [
              "null",
              "string"
            ]
          },
          "source_id": {
            "description": "Source UUID.",
            "type": "string"
          },
          "source_url": {
            "description": "Canonical URL of the news source.",
            "type": "string"
          },
          "title": {
            "description": "News title.",
            "type": "string"
          }
        },
        "required": [
          "news_id",
          "source_id",
          "news_text"
        ],
        "title": "SerezhaCallBody",
        "type": "object"
      },
      "ValeraCallBody": {
        "additionalProperties": false,
        "properties": {
          "company": {
            "additionalProperties": true,
            "description": "Company JSON object used to build the Markdown profile and metric settings.",
            "type": "object"
          },
          "companyId": {
            "description": "Company UUID.",
            "type": "string"
          },
          "profileRevision": {
            "description": "Monotonically increasing profile revision.",
            "type": "integer"
          }
        },
        "required": [
          "companyId",
          "profileRevision",
          "company"
        ],
        "title": "ValeraCallBody",
        "type": "object"
      },
      "ValeraCallEnvelope": {
        "additionalProperties": false,
        "properties": {
          "agent": {
            "description": "Compatibility field; agent query parameter remains authoritative.",
            "type": "string"
          },
          "payload": {
            "additionalProperties": false,
            "description": "Valera payload.",
            "properties": {
              "company": {
                "additionalProperties": true,
                "description": "Company JSON object used to build the Markdown profile and metric settings.",
                "type": "object"
              },
              "companyId": {
                "description": "Company UUID.",
                "type": "string"
              },
              "profileRevision": {
                "description": "Monotonically increasing profile revision.",
                "type": "integer"
              }
            },
            "required": [
              "companyId",
              "profileRevision",
              "company"
            ],
            "type": "object"
          }
        },
        "required": [
          "payload"
        ],
        "title": "ValeraCallEnvelope",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ESBBearer": {
        "bearerFormat": "ESB_API_KEY",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "HTTP contract for Domain integrations. WebSocket messages are documented in asyncapi.json; MCP tools are documented in mcp-tools.md.",
    "title": "Predictor ESB HTTP API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/call": {
      "get": {
        "description": "Use `agent` to read an agent call/report or `data=facts` to query ClickHouse facts. Filters and IDs are sent in the JSON body, including for GET requests. GET for Konstantin by company returns bounded chat history and queues an analysis if its current result is missing or stale.",
        "operationId": "readCallOrFacts",
        "parameters": [
          {
            "description": "Agent whose call or company report is requested. Mutually exclusive with data=facts.",
            "in": "query",
            "name": "agent",
            "required": false,
            "schema": {
              "enum": [
                "serezha",
                "saveliy",
                "valera",
                "kesha",
                "konstantin"
              ],
              "type": "string"
            }
          },
          {
            "description": "Set to facts to query ClickHouse facts instead of an agent result.",
            "in": "query",
            "name": "data",
            "required": false,
            "schema": {
              "enum": [
                "facts"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/CallLookupBody"
                  },
                  {
                    "$ref": "#/components/schemas/FactsQueryBody"
                  }
                ]
              }
            }
          },
          "description": "Call lookup, consultant history, or fact filters.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Call"
                    },
                    {
                      "$ref": "#/components/schemas/CompanyReport"
                    },
                    {
                      "$ref": "#/components/schemas/ConsultantReady"
                    },
                    {
                      "$ref": "#/components/schemas/FactsResponse"
                    }
                  ]
                }
              }
            },
            "description": "A call, report, fact page, or ready consultant result."
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsultantProcessing"
                }
              }
            },
            "description": "The consultant analysis was queued or is still processing."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid request or JSON body."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bearer token is missing or invalid."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Requested call or conversation was not found."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The request conflicts with current profile or source state."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "ESB could not complete the request."
          }
        },
        "security": [
          {
            "ESBBearer": []
          }
        ],
        "summary": "Read a call, company report, facts, or consultant state",
        "tags": [
          "calls"
        ]
      },
      "post": {
        "description": "Select the agent with the `agent` query parameter. Every accepted call returns `call_id`; read its status with GET /call using the same agent. The JSON body shape depends on the agent.",
        "operationId": "enqueueAgentCall",
        "parameters": [
          {
            "description": "Agent to invoke.",
            "in": "query",
            "name": "agent",
            "required": true,
            "schema": {
              "enum": [
                "serezha",
                "saveliy",
                "valera",
                "kesha",
                "konstantin"
              ],
              "type": "string"
            }
          },
          {
            "description": "Optional request idempotency key.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ValeraCallBody"
                  },
                  {
                    "$ref": "#/components/schemas/ValeraCallEnvelope"
                  },
                  {
                    "$ref": "#/components/schemas/SerezhaCallBody"
                  },
                  {
                    "$ref": "#/components/schemas/SaveliyCallBody"
                  },
                  {
                    "$ref": "#/components/schemas/KeshaCallBody"
                  },
                  {
                    "$ref": "#/components/schemas/KonstantinCallBody"
                  }
                ]
              }
            }
          },
          "description": "Agent-specific JSON payload.",
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedCall"
                }
              }
            },
            "description": "The asynchronous call was accepted."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid request or JSON body."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bearer token is missing or invalid."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The request conflicts with current profile or source state."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "ESB could not complete the request."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A required dependency is unavailable."
          }
        },
        "security": [
          {
            "ESBBearer": []
          }
        ],
        "summary": "Start an asynchronous agent call",
        "tags": [
          "calls"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Public process liveness endpoint.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Service is alive."
          }
        },
        "summary": "Liveness check",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Checks the dependencies required by ESB.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "All required dependencies are available."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A required dependency is unavailable."
          }
        },
        "security": [
          {
            "ESBBearer": []
          }
        ],
        "summary": "Dependency readiness",
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:8081"
    }
  ],
  "tags": [
    {
      "description": "Service health.",
      "name": "health"
    },
    {
      "description": "Asynchronous agent calls and their results.",
      "name": "calls"
    },
    {
      "description": "Read-only ClickHouse fact queries.",
      "name": "facts"
    }
  ]
}
