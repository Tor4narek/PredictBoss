# Copy to .env. Keep credentials out of Git.
LLM_API_KEY=
HERMES_API_KEY=replace-with-a-random-secret
ESB_API_KEY=replace-with-a-different-random-secret
ATLAS_TOKEN=

# Domain application
DOMAIN_JWT_KEY=replace-with-a-random-secret-at-least-32-bytes
DOMAIN_JWT_ISSUER=predictor-domain
DOMAIN_JWT_AUDIENCE=predictor-domain
DOMAIN_CSV_PATH=./predictor/domain/data/df_Uid_data_hack.csv
DOMAIN_POSTGRES_DB=predictor_domain
DOMAIN_POSTGRES_USER=predictor_domain
DOMAIN_POSTGRES_PASSWORD=replace-with-a-long-random-secret
SWAGGER_ENABLED=false

# Bind application and storage ports to loopback; host Caddy proxies HTTPS traffic.
HOST_BIND_ADDRESS=127.0.0.1

# Domain app: keep the company CSV outside Git and set its absolute path on Fedora.
DOMAIN_JWT_KEY=replace-with-a-random-secret-at-least-32-bytes
DOMAIN_JWT_ISSUER=predictor-domain
DOMAIN_JWT_AUDIENCE=predictor-domain
DOMAIN_CSV_PATH=./predictor/domain/data/df_Uid_data_hack.csv
DOMAIN_POSTGRES_DB=predictor_domain
DOMAIN_POSTGRES_USER=predictor_domain
DOMAIN_POSTGRES_PASSWORD=replace-with-a-long-random-secret
SWAGGER_ENABLED=false

# Local app ports bind to loopback. Production public traffic goes through Caddy.
HOST_BIND_ADDRESS=127.0.0.1
PUBLIC_DOMAIN=system.onix.fun

# PostgreSQL local development defaults
POSTGRES_DB=predictor
POSTGRES_USER=predictor
POSTGRES_PASSWORD=local-predictor-password

# ClickHouse HTTP interface
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=predictor
CLICKHOUSE_PASSWORD=local-clickhouse-password

# Local MinIO for company Markdown profiles (change these only for a private deployment)
MINIO_IMAGE=dappros/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=predictor-local
MINIO_ROOT_PASSWORD=local-minio-password-change-me
S3_BUCKET=company-profiles
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=predictor-local
S3_SECRET_ACCESS_KEY=local-minio-password-change-me
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
