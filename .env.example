# Copy to .env. Keep credentials out of Git.
LLM_API_KEY=
HERMES_API_KEY=replace-with-a-random-secret
ESB_API_KEY=replace-with-a-different-random-secret

# Domain service (JWT secret must be at least 32 bytes). Point to the provided CSV on this host.
DOMAIN_JWT_KEY=replace-with-a-random-secret-at-least-32-bytes
DOMAIN_JWT_ISSUER=predictor-domain
DOMAIN_JWT_AUDIENCE=predictor-domain
DOMAIN_CSV_PATH=./predictor/domain/data/df_Uid_data_hack.csv
DOMAIN_POSTGRES_DB=predictor_domain
DOMAIN_POSTGRES_USER=predictor_domain
DOMAIN_POSTGRES_PASSWORD=local-domain-password
SWAGGER_ENABLED=true

# PostgreSQL local development defaults
POSTGRES_DB=predictor
POSTGRES_USER=predictor
POSTGRES_PASSWORD=local-predictor-password

# ClickHouse HTTP interface
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=predictor
CLICKHOUSE_PASSWORD=local-clickhouse-password

# S3-compatible storage for company Markdown profiles
S3_BUCKET=company-profiles
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
