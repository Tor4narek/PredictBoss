# Copy to .env. Keep credentials out of Git.
LLM_API_KEY=
HERMES_API_KEY=replace-with-a-random-secret
ESB_API_KEY=replace-with-a-different-random-secret
ATLAS_TOKEN=

# PostgreSQL local development defaults
POSTGRES_DB=predictor
POSTGRES_USER=predictor
POSTGRES_PASSWORD=local-predictor-password

# ClickHouse HTTP interface
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=predictor
CLICKHOUSE_PASSWORD=local-clickhouse-password

# Local MinIO for company Markdown profiles (change these only for a private deployment)
MINIO_IMAGE=dappros/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=predictor-local
MINIO_ROOT_PASSWORD=local-minio-password-change-me
S3_BUCKET=company-profiles
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=predictor-local
S3_SECRET_ACCESS_KEY=local-minio-password-change-me
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
